    {
      "text": "%sh\n\ncd $(mktemp -d)\nwget https://s3.amazonaws.com/apache-zeppelin/tutorial/bank/bank.csv\nif ! hadoop fs -test -e bank.csv; then\n    hadoop fs -put bank.csv .\nelse\n    echo \"bank.csv already in your home directory in DFS\"\nfi",
